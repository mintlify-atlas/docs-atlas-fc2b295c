  "keyFeatures": [
    "Multi-chain transaction submission (RPC, Fast, Gas Sponsor, Bundle modes)",
    "High-performance Mempool streaming with MEV protection",
    "Low-latency Block Stream for Solana, BSC, and Base",
    "Network Fee Stream for real-time gas price data",
    "BSC Block Builder with 37% historical block production rate",
    "Node Stream for synchronized full-node world-state data",
    "Global acceleration network for ultra-low-latency transaction propagation",
    "Bundle support for backrunning, copy trading, and sniping strategies"
  ],
